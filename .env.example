# 复制到服务器，例如 /opt/gambit-oa/.env，然后填入真实值。

# SQLAlchemy 数据库连接串。
# 示例：mysql+pymysql://user:password@host:3306/database?charset=utf8mb4
DATABASE_URL=

# 兼容部署配置。
JWT_SECRET=

# Flask SECRET_KEY。
SECRET_KEY=

# OA 后端调用 GambitServer 内部管理接口。
GAMBIT_SERVER_BASE_URL=
GAMBIT_INTERNAL_TOKEN=

# Temporary OA password mode; set sms after Tencent SMS approval/configuration.
OA_LOGIN_MODE=password

# SMS mode requires a random secret of at least 32 characters.
OA_AUTH_SECRET=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
# Approved template must have exactly ONE parameter: six-digit code; fixed validity 5 minutes.
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Go / OA 必须在期初初始化完成后同时启用；默认关闭。
STORE_SETTLEMENT_ENABLED=false

# Required in password mode; provide through the deployment environment.
OA_ADMIN_PASSWORD=

# Must match the existing GambitServer phone encryption key; do not rotate during migration.
PHONE_CRYPTO_KEY=

COS_SECRET_ID=
COS_SECRET_KEY=
